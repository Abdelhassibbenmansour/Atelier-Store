# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (Neon console -> Connect). Use the pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Better Auth
# Generate a secret with: npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-random-32+-char-secret"
# Base URL of the app (server-side)
BETTER_AUTH_URL="http://localhost:3000"

# Base URL exposed to the browser (used by the auth client)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (use a sandbox for development: https://docs.stripe.com/sandboxes)
# Prefer a restricted key (rk_test_…) with: Checkout Sessions = Write, PaymentIntents = Read.
STRIPE_SECRET_KEY="rk_test_replace-me"
# Webhook signing secret. Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints it. In production: the endpoint's secret from the Stripe Dashboard, listening to
# checkout.session.completed, .async_payment_succeeded, .async_payment_failed, .expired
STRIPE_WEBHOOK_SECRET="whsec_replace-me"
